# Programmatic dependent launch for the decode expert kernels (TF_GLM_PDL, on by default): rot_in, the decode
# trellis kernel and its two fused epilogues launch with programmatic stream serialization, so their blocks are
# scheduled and set up while the previous kernel of the stream still runs; each kernel calls
# cudaGridDependencySynchronize() before its first load, so the bits are the same as the plain launch, only the
# launch latency hides (the same idea as DeepInfer's set_pdl(True), here on the EXL3 decode chain). SM90 and later
# take the device sync; older archs and TF_GLM_PDL=0 keep the plain launch. Launch sites in exl3.cu only (the
# prompt grouped kernel and the other kernels' launches are untouched); CUDA graphs capture the attribute.
diff --git tensorfold/families/glm5_next/cuda/exl3.cu tensorfold/families/glm5_next/cuda/exl3.cu
index c14c1b3..8a9ad94 100644
--- tensorfold/families/glm5_next/cuda/exl3.cu
+++ tensorfold/families/glm5_next/cuda/exl3.cu
@@ -11,12 +11,45 @@
 
 #include <cuda_fp16.h>
 #include <cuda_bf16.h>
+#include <cstdlib>
 #include <ATen/ATen.h>
 #include <ATen/cuda/CUDAContext.h>
 #include <c10/cuda/CUDAGuard.h>
 
 namespace {
 
+// TF_GLM_PDL (default on; TF_GLM_PDL=0 off): launches with programmatic stream serialization, so a kernel's blocks
+// are scheduled and set up while the previous kernel of the stream still runs, and the hardware chains the two
+// grids (PDL). Launch order only, the same bits either way, like the launch-order template parameter below; no
+// kernel's math changes. Each launched kernel calls cudaGridDependencySynchronize() before its first load, which
+// compiles for SM90 and later and is a no-op without the launch attribute (or before SM90).
+inline bool pdl_on() {
+    static const bool on = [] {
+        const char* v = getenv("TF_GLM_PDL");
+        return !(v && v[0] == '0' && v[1] == '\0');
+    }();
+    return on;
+}
+
+template <typename K, typename... A>
+inline void launch_pdl(K kernel, dim3 grid, dim3 block, cudaStream_t stream, A... args) {
+    if (pdl_on()) {
+        cudaLaunchConfig_t cfg{};
+        cfg.gridDim = grid;
+        cfg.blockDim = block;
+        cfg.dynamicSmemBytes = 0;
+        cfg.stream = stream;
+        cudaLaunchAttribute attr[1];
+        attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+        attr[0].val.programmaticStreamSerializationAllowed = 1;
+        cfg.attrs = attr;
+        cfg.numAttrs = 1;
+        cudaLaunchKernelEx(&cfg, kernel, args...);
+        return;
+    }
+    kernel<<<grid, block, 0, stream>>>(args...);
+}
