new file mode 100644
index 0000000..20d502f
--- /dev/null
+++ tensorfold/families/glm5_next/cuda/estimators.py
@@ -0,0 +1,66 @@
+"""Decode-round timing tables, by verify-row count (TF_GLM_EST, on by default; TF_GLM_EST=0 off).
+
+DeepInfer's confidence-scheduled verification (its MTPVarlen scheduler, csrc/engine/mtp_varlen.hpp) picks each
+round's verify budget from a profiled decode performance curve (milliseconds a verify forward over R rows takes)
+plus a sliding-median sampler cost, choosing the budget that maximizes tokens a millisecond. This records the same
+two tables on this setup: a round's verify GPU time from a CUDA event pair, and the sampler's host side, both per
+total verify rows. The event pair is read after the round's sampler has synchronized the forward anyway, so no
+extra sync is added (RoundProfile reads its own pair the same way). Read-only observation on both ranks: nothing
+branches on it yet, so the two ranks stay exactly in step; a verify-budget search will be the first reader. The
+medians go to /health ("est") and /metrics."""
+
+from __future__ import annotations
+
+import os
+import statistics
+import time
+
+import torch
+
+ENABLED = os.environ.get("TF_GLM_EST", "1") != "0"
+WINDOW = 9                       # samples kept per row count (DeepInfer's sliding median)
+MIN_SAMPLES = 3                  # samples before a row count's median is reported
+
+
+class _Rows:
+    """Milliseconds by verify-row count, a sliding median per count."""
+
+    def __init__(self) -> None:
+        self.samples: dict[int, list[float]] = {}
+
+    def observe(self, rows: int, ms: float) -> None:
+        bucket = self.samples.setdefault(int(rows), [])
+        bucket.append(float(ms))
+        del bucket[:-WINDOW]
+
+    def medians(self) -> dict[int, float]:
+        return {rows: round(statistics.median(values), 3) for rows, values in sorted(self.samples.items())
+                if len(values) >= MIN_SAMPLES}
+
+
+class Estimators:
+    """The two tables, plus the CUDA event pair a round's verify GPU time is read from."""
+
+    def __init__(self) -> None:
+        self.cuda = torch.cuda.is_available()
+        self.ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)] if self.cuda else None
+        self.verify = _Rows()
+        self.sample = _Rows()
+        self.rounds = 0
+
+    def gpu_begin(self) -> None:
+        if self.ev is not None:
+            self.ev[0].record()
+
+    def gpu_end(self) -> None:
+        if self.ev is not None:
+            self.ev[1].record()
+
+    def observe(self, rows: int, sample_s: float) -> None:
+        self.rounds += 1
+        if self.ev is not None:
+            self.verify.observe(rows, self.ev[0].elapsed_time(self.ev[1]))
+        self.sample.observe(rows, sample_s * 1e3)
+
+    def info(self) -> dict:
+        return {"rounds": self.rounds, "verify_ms": self.verify.medians(), "sample_ms": self.sample.medians()}
